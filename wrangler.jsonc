{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ashnioptometrists",
  "main": "./dist/server/index.mjs",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
